APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Dedicated queue names so you can run separate workers in production.
QUEUE_EMAILS_NAME=emails
QUEUE_APOLLO_FETCH_NAME=apollo-fetch
QUEUE_AI_TRANSCRIPT_NAME=ai-transcript
QUEUE_AI_INGEST_NAME=ai-ingest
QUEUE_AI_CHAT_NAME=ai-chat
QUEUE_AI_VIDEO_COMPOSE_NAME=ai-video-compose

# Legacy worker command examples (only use these if NOT using Horizon):
# If Horizon is enabled, run `php artisan horizon` and let Horizon manage queues.
# php artisan queue:work --queue=default --sleep=1 --tries=3 --timeout=120
# php artisan queue:work --queue=emails --sleep=1 --tries=3 --timeout=120
# php artisan queue:work --queue=ai-transcript --sleep=1 --tries=1 --timeout=3600
# php artisan queue:work --queue=ai-ingest --sleep=1 --tries=2 --timeout=900
# php artisan queue:work --queue=ai-chat --sleep=1 --tries=2 --timeout=180
# php artisan queue:work --queue=apollo-fetch --sleep=1 --tries=3 --timeout=120
# php artisan queue:work --queue=ai-video-compose --sleep=1 --tries=1 --timeout=7200

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

REVERB_APP_ID=webinar-app
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

EMAIL_PROVIDER_PRIMARY=postmark
EMAIL_PROVIDER_FALLBACK=resend

# Supported: postmark, resend, elastic, zeptomail, ses_smtp, smtp
ELASTICEMAIL_API_KEY=
ELASTICEMAIL_FROM="Webinars <hello@example.com>"
ELASTICEMAIL_CHANNEL=

ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM="Webinars <hello@example.com>"

POSTMARK_API_KEY=
POSTMARK_FROM="Webinars <hello@example.com>"
POSTMARK_MESSAGE_STREAM_ID=
POSTMARK_WEBHOOK_TOKEN=

# Controls how email batches are spaced out when dispatching queued jobs
# (for registration imports, reminders, and follow-ups).
# Example for 20,000 emails:
# - WEBINAR_EMAIL_BATCH_SIZE=100  -> 200 jobs
# - WEBINAR_EMAIL_BATCH_DELAY_INCREMENT_SECONDS=20 -> last job ~66 minutes later
WEBINAR_EMAIL_BATCH_SIZE=100
WEBINAR_EMAIL_BATCH_DELAY_BASE_SECONDS=0
WEBINAR_EMAIL_BATCH_DELAY_INCREMENT_SECONDS=5

SES_SMTP_MAILER=ses
SES_SMTP_TRANSPORT=ses
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_SCHEME=tls
SES_SMTP_TIMEOUT=10
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_SMTP_FROM_ADDRESS="noreply@example.com"
SES_SMTP_FROM_NAME="${APP_NAME}"
SES_SMTP_EHLO_DOMAIN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

RESEND_API_KEY=
RESEND_FROM="Webinars <onboarding@resend.dev>"

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_TIMEOUT_SECONDS=180

HEYGEN_API_KEY=
HEYGEN_OPTIONS_LIMIT=50
HEYGEN_OPTIONS_TIMEOUT_SECONDS=30
HEYGEN_OPTIONS_CONNECT_TIMEOUT_SECONDS=10
HEYGEN_GENERATE_TIMEOUT_SECONDS=240
HEYGEN_GENERATE_CONNECT_TIMEOUT_SECONDS=30
HEYGEN_GENERATE_RETRY_COUNT=1

OPENAI_TRANSCRIPTION_MODEL=whisper-1
FFMPEG_BIN=ffmpeg
YT_DLP_BIN=yt-dlp
AI_TRANSCRIPT_CHUNK_SECONDS=300
AI_TRANSCRIPT_FFMPEG_TIMEOUT_SECONDS=7200
AI_TRANSCRIPT_OPENAI_TIMEOUT_SECONDS=180
APOLLO_API_KEY=
APOLLO_SEARCH_ENDPOINT=https://api.apollo.io/api/v1/mixed_people/search
APOLLO_FETCH_MAX_COUNT=250

# Lead provider abstraction for attendee import.
# Supported: apollo, d7
LEAD_PROVIDER=apollo
# Optional fallback provider when the primary fails.
LEAD_PROVIDER_FALLBACK=

# D7 Lead Finder settings (used when LEAD_PROVIDER=d7).
D7_API_KEY=
D7_TIMEOUT_SECONDS=60
D7_FETCH_MAX_COUNT=1200

# Comma-separated list of emails allowed to access Admin > Users.
ADMIN_EMAILS=

CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_NOTIFICATION_URL=

# Optional explicit credentials (if CLOUDINARY_URL is not used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_VIDEO_FOLDER=webinars/heygen

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
